---
import Topic from '../layouts/Topic.astro';
import { profile } from '../data/profile';
import { todoClass } from '../lib/rutherford';
---

<Topic href="/elsewhere">
  <ul class="links">
    {
      profile.socials.map((s) => (
        <li>
          <a href={s.url}>
            <span class="links__label">{s.label}</span>
            <span class="links__handle">{s.handle}</span>
          </a>
        </li>
      ))
    }
    <li>
      <a href={`mailto:${profile.email}`} class={todoClass(profile.email)}>
        <span class="links__label">Email</span>
        <span class="links__handle">{profile.email}</span>
      </a>
    </li>
  </ul>
</Topic>
