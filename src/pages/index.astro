---
// ── The letter ───────────────────────────────────────────────────────────────
// The home page is a short letter: one paragraph in the first person, the
// sections of the site linked from inside its sentences as numbered
// references, the dated "now" line, and a short list of what is newest. The
// words of the letter live here — edit them as prose. Which sections exist,
// and the "now" line, come from ../data/letter.ts. The reference numbers are
// a CSS counter (letter.css, "References"): reading order, nothing to keep.
//
// Layout is CSS — see ../styles/letter.css. The one script is the intro
// (../scripts/letter-intro.ts): the first time in a session, the greeting is
// typed and the rest of the letter eases in around it. The page is complete
// without it.
import Layout from '../layouts/Layout.astro';
import '../styles/letter.css';
import { profile } from '../data/profile';
import { now, sectionFor } from '../data/letter';
import { getRecent } from '../lib/content';
import { FONT_LINKS } from '../lib/letter';
import { todoClass } from '../lib/todo';

const recent = await getRecent(4);

// A section linked from the letter: checked against letter.ts, so the letter
// can never point at a page that does not exist.
const sec = (href: string) => ({ href, title: sectionFor(href).label });
const projects = sec('/projects');
const writing = sec('/writing');
const interests = sec('/interests');
const about = sec('/about');
const elsewhere = sec('/elsewhere');

const year = new Date().getFullYear();

// The first words of the letter, typed on first opening (letter-intro.ts).
const greeting = `Hi, I'm ${profile.name}`;
---

<Layout
  title={profile.name}
  description={profile.tagline}
  bodyClass="letter"
  fontLinks={FONT_LINKS}
>
  <!-- Decided before the first paint, so the intro never flashes the page:
       once per session, and never for those who prefer reduced motion.
       Opening /#intro plays it again. -->
  <script is:inline>
    try {
      var again = location.hash === '#intro';
      if ((again || !sessionStorage.getItem('letter-intro')) && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('intro');
      }
    } catch {}
  </script>

  <canvas id="renaissance-field" class="renaissance-field" aria-hidden="true"></canvas>

  <header class="top">
    <a href="/">{profile.name}</a>
    <span>{profile.location} · {year}</span>
  </header>

  <main class="page">
    <!-- The letter. .lead__hi is what the intro types; keep it the start of the
         sentence, and keep the two spans adjacent so no space slips between.
         Every link is class="ref": the numbers come from reading order. No
         figures in the letter itself. -->
    <p class="lead">
      <span class="lead__hi" data-text={greeting}>{greeting}</span><span class="lead__rest">, an <strong>engineer from Spain</strong> based in Luxembourg.
        On the side I build <a class="ref" href={projects.href} title={projects.title}>projects</a>
        and write about <a class="ref" href={writing.href} title={writing.title}>how it goes</a>.
        I'm very curious, so I keep <a class="ref" href={interests.href} title={interests.title}>consuming knowledge</a>.
        There is a bit more <a class="ref" href={about.href} title={about.title}>about me</a>,
        and you can find me on <a class="ref" href={elsewhere.href} title={elsewhere.title}>other social media</a>.</span>
    </p>

    <p class="now">
      <span class={todoClass(now.text)}>{now.text}</span>
      <span class={`now__stamp ${todoClass(now.updated)}`}>{now.updated}</span>
    </p>

    <section class="recently" aria-labelledby="recently">
      <h2 class="recently__head" id="recently">Recently</h2>
      <ul>
        {
          recent.map((r) => (
            <li>
              <span class="recently__date">{r.when}</span>
              <a class="recently__title ref" href={r.href}>{r.title}</a>
              <span class="recently__kind">{r.kind}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <footer class="foot">
    <a href={`mailto:${profile.email}`} class={todoClass(profile.email)}>{profile.email}</a>
    <nav aria-label="Elsewhere">
      {profile.socials.map((s) => <a href={s.url}>{s.label}</a>)}
      <a href={`mailto:${profile.email}`}>Email</a>
    </nav>
  </footer>
</Layout>

<script>
  import { startIntro } from '../scripts/letter-intro';
  import { startRenaissanceField } from '../scripts/renaissance-field';

  const canvas = document.querySelector<HTMLCanvasElement>('#renaissance-field');
  const page = document.querySelector<HTMLElement>('.page');
  if (canvas) {
    startRenaissanceField(canvas, page);
  }

  startIntro();
</script>
