---
// ── The home page: the letter, and the graph it becomes ─────────────────────
// The site as a place: everything on it as one network, the name at the
// centre — work, study, projects, places, and the shelf — with a few ideas
// where they cross. The letter's paper, ink and one rust accent, which marks
// what is still going; its type, with book and podcast titles in italics as
// titles are. The sections of the site sit at the edges of the screen.
//
// It opens on the letter, the home page's words in the home page's type — the
// greeting typed the first time in a session, as on the home — and when the
// reader moves on the letter becomes the graph: the facts fly to their
// nodes, the links to the edges of the screen, and the rest grows out of where
// they land (../scripts/graph-letter.ts). /#graph opens on the graph. The
// earlier home — the letter alone, with the "now" line and what is newest —
// is kept as a draft at /letter.
//
// The layout is settled here, at build time (../lib/graph-sim.ts from
// ../data/graph.ts), and written into the HTML, so the graph stands without a
// script. ../scripts/graph.ts makes it alive: it keeps breathing; a node shows
// its neighbours, can be dragged, and opens its card, which lists what it
// connects to — so the graph can be walked. Styles: ../styles/graph.css.
import Layout from '../layouts/Layout.astro';
import '../styles/graph.css';
import { profile } from '../data/profile';
import { sections, sectionFor } from '../data/letter';
import { graph } from '../data/graph';
import { FONT_LINKS } from '../lib/letter';
import { bodies, springs, settleBest, crossings, look, baseline, type Sheet } from '../lib/graph-sim';

const { nodes, edges } = graph;
const sheet: Sheet = { w: 1600, h: 900, cx: 800, cy: 400, gx: 0.006, gy: 0.016, margin: 64 };
const b = bodies(nodes);
const me = b.find((x) => x.kind === 'me')!;
me.fx = sheet.cx;
me.fy = sheet.cy;
const s = springs(nodes, edges);
const seed = settleBest(b, s, sheet, 24);
console.log(`graph: seed ${seed}, ${crossings(b, s)} crossings`);

const r1 = (n: number) => Math.round(n * 10) / 10;
const at = new Map(nodes.map((n, i) => [n.id, i]));
const bold = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');

const KIND: Record<string, string> = {
  me: 'The letter', work: 'Work', study: 'Study', project: 'Project', place: 'Place', idea: 'Idea',
  hub: 'Interests', theme: 'Theme', book: 'Book', podcast: 'Podcast',
};

// What the script needs: every node, its settled place, its card; every edge.
const data = {
  sheet,
  nodes: nodes.map((n, i) => ({
    id: n.id, label: n.label, kind: n.kind, live: !!n.live, favourite: !!n.favourite,
    kindLabel: KIND[n.kind], meta: n.meta ?? '', detail: bold(n.detail ?? ''), href: n.href ?? '',
    x: r1(b[i].x), y: r1(b[i].y), bw: r1(b[i].bw), bh: r1(b[i].bh),
  })),
  edges: edges.map(([a, c]) => [at.get(a)!, at.get(c)!]),
};

const edgesNav = [{ label: 'The letter', href: '/' }, ...sections];

// The letter. Its words live here — edit them as prose; data-to says where
// each word goes when it becomes the graph: a node, or the edge word of its
// section.
const sec = (href: string) => ({ href, title: sectionFor(href).label });
const projects = sec('/projects');
const writing = sec('/writing');
const interests = sec('/interests');
const about = sec('/about');
const connect = sec('/connect');
const groups = ['work', 'study', 'project', 'place', 'idea', 'theme', 'book', 'podcast'] as const;
---

<Layout title={profile.name} description={profile.tagline} bodyClass="graph" fontLinks={FONT_LINKS}>
  <!-- Decided before the first paint, so the graph never flashes under the letter. -->
  <script is:inline>
    // And, as on the home page: the greeting is typed the first time in a session (or at #intro).
    try {
      var root = document.documentElement;
      if (location.hash !== '#graph') root.classList.add('letter-first');
      if (root.classList.contains('letter-first') && (location.hash === '#intro' || !sessionStorage.getItem('letter-intro')) && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        root.classList.add('intro');
      }
    } catch {}
  </script>

  <section class="letter" aria-label="The letter">
    <!-- .lead__hi is what the intro types (letter-intro.ts), the name inside it
         what flies to the centre; keep the two spans adjacent, so no space
         slips between them. Every link is class="ref": the numbers come from
         reading order. -->
    <p class="lead">
      <span class="lead__hi">Hi, I'm <span data-to="node:me">{profile.name}</span></span><span class="lead__rest">, an <strong><span data-to="node:engineering">engineer</span> from <span data-to="node:valencia">Spain</span></strong> based in <span data-to="node:luxembourg">Luxembourg</span>.
      On the side I build <a class="ref" href={projects.href} title={projects.title} data-to={`edge:${projects.href}`}>projects</a>
      and write about <a class="ref" href={writing.href} title={writing.title} data-to={`edge:${writing.href}`}>how it goes</a>.
      I'm very curious, so I keep <a class="ref" href={interests.href} title={interests.title} data-to={`edge:${interests.href}`}>consuming knowledge</a>.
      There is a bit more <a class="ref" href={about.href} title={about.title} data-to={`edge:${about.href}`}>about me</a>,
      and you can <a class="ref" href={connect.href} title={connect.title} data-to={`edge:${connect.href}`}>reach out or connect</a>.</span>
    </p>
    <button class="letter__go" type="button">How it all connects</button>
  </section>

  <nav class="edges" aria-label="Sections">
    {edgesNav.map((e, i) => <a class={`edge edge--${i}`} href={e.href}>{e.label}</a>)}
  </nav>

  <main class="sheet">
    <svg class="net" viewBox={`0 0 ${sheet.w} ${sheet.h}`} role="img" aria-labelledby="graph-title">
      <title id="graph-title">Everything on {profile.name}'s site and how it connects; the parts are listed after the graph.</title>
      <g class="world">
        <g class="links" aria-hidden="true">
          {
            data.edges.map(([a, c]) => (
              <line x1={b[a].x} y1={b[a].y} x2={b[c].x} y2={b[c].y} data-a={a} data-b={c} />
            ))
          }
        </g>
        <g class="nodes">
          {
            nodes.map((n, i) => {
              const l = look(n);
              return (
                <a
                  class={`node node--${n.kind}${n.live ? ' is-live' : ''}${n.favourite ? ' is-fav' : ''}`}
                  href={n.href || '/'}
                  data-i={i}
                  transform={`translate(${r1(b[i].x)} ${r1(b[i].y)})`}
                >
                  {n.kind === 'theme' ? (
                    <rect class="node__dot" x={-l.r} y={-l.r} width={l.r * 2} height={l.r * 2} />
                  ) : (
                    <circle class="node__dot" r={l.r} />
                  )}
                  {n.live && <circle class="node__pulse" r={l.r + 3} />}
                  <text class="node__label" y={r1(baseline(n))} text-anchor="middle">{n.label}</text>
                </a>
              );
            })
          }
        </g>
      </g>
    </svg>

    <p class="caption" aria-hidden="true">Everything on this site, and how it connects. Drag anything; open anything.</p>

    <div class="card" role="dialog" aria-labelledby="card-title" hidden>
      <p class="card__meta"></p>
      <h2 class="card__title" id="card-title"></h2>
      <p class="card__detail"></p>
      <p class="card__near-head">Connected to</p>
      <ul class="card__near"></ul>
      <p class="card__actions"><a class="card__go" href="/">Open</a><button class="card__close" type="button">Close</button></p>
    </div>

    <!-- The graph as lists, for screen readers and anyone without the picture. -->
    <div class="as-list">
      {
        groups.map((g) => (
          <section>
            <h2>{KIND[g]}</h2>
            <ul>
              {nodes.filter((n) => n.kind === g).map((n) => (
                <li>
                  <a href={n.href || '/'}>{n.label}</a>
                  {n.meta && `, ${n.meta}`}. <span set:html={bold(n.detail ?? '')} />
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </main>

  <script type="application/json" id="graph-data" set:html={JSON.stringify(data)} />
</Layout>

<script>
  import { startGraph } from '../scripts/graph';
  import { startLetter } from '../scripts/graph-letter';
  import { startIntro } from '../scripts/letter-intro';
  const letterFirst = document.documentElement.classList.contains('letter-first');
  const graph = startGraph({ bloom: !letterFirst });
  if (letterFirst) {
    startLetter(graph);
    startIntro();
  }
</script>
