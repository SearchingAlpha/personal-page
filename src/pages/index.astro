---
// ── Rutherford ───────────────────────────────────────────────────────────────
// The home page is an atom: the name as nucleus, every topic an electron on a
// tilted orbit. Geometry, motion and depth are all CSS — see
// ../styles/rutherford.css. Which electrons exist lives in ../data/atom.ts.
import Layout from '../layouts/Layout.astro';
import '../styles/rutherford.css';
import { profile } from '../data/profile';
import { orbits } from '../data/atom';
import { FONT_LINKS, RX, RY, laneStyle } from '../lib/rutherford';
---

<Layout
  title={profile.name}
  description={profile.tagline}
  bodyClass="rutherford"
  fontLinks={FONT_LINKS}
>
  <main class="stage">
    <div class="atom" style={`--rx:${RX}%;--ry:${RY}%`}>
      {orbits.map((o) => <div class="ring" style={`--tilt:${o.tilt}deg`} aria-hidden="true" />)}

      <h1 class="nucleus">{profile.name}</h1>

      <nav class="electrons" aria-label="Topics">
        {
          orbits.map((o) =>
            o.electrons.map((e) => (
              <div class="lane" style={laneStyle(o, e)}>
                <a class="electron" href={e.href}>
                  <span class="electron__body">
                    <span class="electron__dot" aria-hidden="true" />
                    <span class="electron__label">{e.label}</span>
                  </span>
                </a>
              </div>
            )),
          )
        }
      </nav>
    </div>
  </main>
</Layout>
