---
import Layout from '../layouts/Layout.astro';
import '../styles/pravah.css';
import { profile } from '../data/profile';
import { getSortedWriting, getProjects, formatDate } from '../lib/content';

const posts = await getSortedWriting();
const projects = getProjects();
const featured = projects.find((p) => p.featured) ?? projects[0];
const shipped = projects.filter((p) => p.status === 'Shipped').length;
const year = new Date().getFullYear();
const nine = Array.from({ length: 9 });
const fontLinks = ['https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap'];
---

<Layout
  title={`${profile.name} — ${profile.role}`}
  description={profile.tagline}
  bodyClass="pravah"
  fontLinks={fontLinks}
>
  <section class="hero" id="top">
    <div class="hero-left">
      <nav class="chips" aria-label="Primary">
        <a class="chip brand" href="/">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0 9.8 6.2 16 8 9.8 9.8 8 16 6.2 9.8 0 8 6.2 6.2Z" />
          </svg>
          {profile.name}
        </a>
        <span class="connector"></span>
        <div class="chip links">
          <a href="#writing">Writing</a>
          <a href="#projects">Projects</a>
          <a href="#about">About</a>
        </div>
        <span class="connector"></span>
        <a class="chip" href={`mailto:${profile.email}`}>Get In Touch</a>
      </nav>
      <div class="rule"></div>

      <div class="hero-copy">
        <p class="lead">Building in public.</p>
        <h1>
          I'm a software engineer making small, useful tools — and writing down how it goes.
        </h1>
        <a class="btn-pill" href="#projects">See The Work</a>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <canvas></canvas>
      <div class="glass glass-a">
        <span class="badge">{featured.status}</span>
        <p class="t">{featured.name} — {featured.status.toLowerCase()} in the open</p>
        <p class="d">{featured.tags.join(' · ')}. {featured.blurb.split('.')[0]}.</p>
      </div>
      <div class="glass glass-b">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <span class="big">{shipped} shipped</span>
        <p class="d">Projects live right now, out of {projects.length} started.</p>
      </div>
    </div>
  </section>

  <section class="band wrap" id="writing">
    <div class="section-head">
      <span class="badge">Writing</span>
      <h2>Notes from the workshop.</h2>
      <p>Long-form, written while the work is still warm. What I'm making, what broke, what I learned.</p>
    </div>
    {
      posts.map((post) => (
        <a class="post" href="#writing">
          <span class="grid-icon" aria-hidden="true">
            {nine.map(() => <i />)}
          </span>
          <div>
            <span class="badge">{post.data.tags[0] ?? 'note'}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.excerpt}</p>
          </div>
          <span class="date">{formatDate(post.data.date)}</span>
        </a>
      ))
    }
  </section>

  <section class="band projects" id="projects">
    <div class="wrap">
      <div class="section-head">
        <span class="badge">Projects</span>
        <h2>What I'm building.</h2>
        <p>{projects.length} projects since 2023. Some shipped, some mid-build, one retired.</p>
      </div>
      <div class="project-grid">
        {
          projects.map((p) => (
            <article class="proj">
              <span class="grid-icon" aria-hidden="true">
                {nine.map(() => <i />)}
              </span>
              <div>
                <h3>{p.name}</h3>
                <p>{p.blurb}</p>
                <div class="meta">
                  <span>{p.status}</span>
                  <span>·</span>
                  <span>{p.year}</span>
                  {p.url && <a href={p.url}>Visit →</a>}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band wrap" id="about">
    <div class="section-head">
      <span class="badge">About</span>
      <h2>{profile.role}.</h2>
      <p>{profile.bio}</p>
    </div>
    <a class="btn-pill" href={`mailto:${profile.email}`}>Get In Touch</a>
  </section>

  <footer class="wrap">
    <span>© {year} {profile.name} · {profile.location}</span>
    <div class="socials">
      {profile.socials.map((s) => <a href={s.url}>{s.label}</a>)}
      <a href="/">All drafts</a>
    </div>
  </footer>
</Layout>

<script>
  // Dot-matrix pylon: the pylon is drawn as strokes on a tiny offscreen
  // canvas (one pixel per grid cell), then every lit cell becomes a small
  // white diamond — the "pixel-mapped photography" look from pravah.com.
  const panel = document.querySelector<HTMLElement>('.pravah .hero-visual');
  const canvas = panel?.querySelector('canvas');
  const ctx = canvas?.getContext('2d');

  if (panel && canvas && ctx) {
    const draw = () => {
      const w = panel.clientWidth;
      const h = panel.clientHeight;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const step = w < 600 ? 6 : 7;
      const cols = Math.ceil(w / step);
      const rows = Math.ceil(h / step);
      const off = document.createElement('canvas');
      off.width = cols;
      off.height = rows;
      const o = off.getContext('2d');
      if (!o) return;
      o.strokeStyle = '#fff';
      o.lineCap = 'round';
      o.lineJoin = 'round';

      const cx = cols * 0.6;
      const top = rows * 0.05;
      const base = rows * 1.04;
      const legW = cols * 0.2;
      const topW = cols * 0.04;
      const hw = (y: number) => topW + ((legW - topW) * Math.max(0, y - top)) / (base - top);
      const line = (x1: number, y1: number, x2: number, y2: number, lw: number) => {
        o.lineWidth = lw;
        o.beginPath();
        o.moveTo(x1, y1);
        o.lineTo(x2, y2);
        o.stroke();
      };

      // Legs + lattice
      line(cx - legW, base, cx - topW, top, 2.6);
      line(cx + legW, base, cx + topW, top, 2.6);
      const seg = rows * 0.075;
      for (let y = top + seg; y < base; y += seg) {
        const y2 = Math.min(y + seg, base);
        line(cx - hw(y), y, cx + hw(y), y, 1);
        line(cx - hw(y), y, cx + hw(y2), y2, 1);
        line(cx + hw(y), y, cx - hw(y2), y2, 1);
      }
      // Cross-arms with struts, insulators and sagging wires to the edges
      const arms: [number, number][] = [
        [0.19, 0.19],
        [0.29, 0.27],
        [0.4, 0.19],
      ];
      for (const [yf, ef] of arms) {
        const y = rows * yf;
        const ext = cols * ef;
        const l = cx - hw(y) - ext;
        const r = cx + hw(y) + ext;
        line(l, y, r, y, 1.8);
        const yu = y - rows * 0.05;
        line(l, y, cx - hw(yu), yu, 1);
        line(r, y, cx + hw(yu), yu, 1);
        line(l + ext * 0.15, y, l + ext * 0.15, y + rows * 0.035, 1.2);
        line(r - ext * 0.15, y, r - ext * 0.15, y + rows * 0.035, 1.2);
        o.lineWidth = 0.9;
        o.beginPath();
        o.moveTo(l, y);
        o.quadraticCurveTo(l * 0.5, y + rows * 0.06, 0, y + rows * 0.02);
        o.stroke();
        o.beginPath();
        o.moveTo(r, y);
        o.quadraticCurveTo(r + (cols - r) * 0.5, y + rows * 0.06, cols, y + rows * 0.02);
        o.stroke();
      }
      // Peak
      line(cx - topW, top, cx, top - rows * 0.03, 1.4);
      line(cx + topW, top, cx, top - rows * 0.03, 1.4);

      // Rasterise: lit cells → diamonds
      const img = o.getImageData(0, 0, cols, rows).data;
      ctx.clearRect(0, 0, w, h);
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const a = img[(r * cols + c) * 4 + 3];
          if (a < 40) continue;
          const strong = a > 170;
          const s = strong ? step * 0.52 : step * 0.3;
          ctx.fillStyle = strong ? 'rgba(255,255,255,0.95)' : 'rgba(255,255,255,0.6)';
          ctx.save();
          ctx.translate(c * step + step / 2, r * step + step / 2);
          ctx.rotate(Math.PI / 4);
          ctx.fillRect(-s / 2, -s / 2, s, s);
          ctx.restore();
        }
      }
      // Scattered sparkle crosses around the structure
      ctx.strokeStyle = 'rgba(255,255,255,0.55)';
      ctx.lineWidth = 1;
      for (let i = 0; i < 140; i++) {
        const x = cx * step + (Math.random() - 0.5) * legW * step * 3.2;
        const y = Math.random() * h;
        if (x < 0 || x > w) continue;
        const L = 2 + Math.random() * 3;
        ctx.beginPath();
        ctx.moveTo(x - L, y);
        ctx.lineTo(x + L, y);
        ctx.moveTo(x, y - L);
        ctx.lineTo(x, y + L);
        ctx.stroke();
      }
    };

    draw();
    let to = 0;
    window.addEventListener('resize', () => {
      clearTimeout(to);
      to = window.setTimeout(draw, 150);
    });
  }
</script>
