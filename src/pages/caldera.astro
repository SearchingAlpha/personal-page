---
import Layout from '../layouts/Layout.astro';
import '../styles/caldera.css';
import { profile } from '../data/profile';
import { getSortedWriting, getProjects, formatDate } from '../lib/content';

const posts = await getSortedWriting();
const projects = getProjects();
const shipped = projects.filter((p) => p.status === 'Shipped').length;
const since = Math.min(...projects.map((p) => p.year));
const year = new Date().getFullYear();

const stats = [
  { lbl: 'Projects started', val: String(projects.length) },
  { lbl: 'Shipped & live', val: String(shipped) },
  { lbl: 'Long-form posts', val: String(posts.length) },
  { lbl: 'Building since', val: String(since) },
];

const fontLinks = [
  'https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=DM+Sans:wght@500;700&display=swap',
];
---

<Layout
  title={`${profile.name} — ${profile.role}`}
  description={profile.tagline}
  bodyClass="caldera"
  fontLinks={fontLinks}
>
  <header class="wrap">
    <nav class="nav">
      <div class="nav-left">
        <a class="brand" href="/">
          <svg viewBox="0 0 28 22" fill="currentColor" aria-hidden="true">
            <path d="M1.5 20c0 0 6.5-15 9.5-15 2 0 3 4 4 4s2-4 4-4c3 0 7.5 15 7.5 15Z" />
          </svg>
          <span class="word">{profile.wordmark}</span>
        </a>
        <span class="vdiv" aria-hidden="true"></span>
        <ul class="nav-links">
          <li><a href="#writing">Writing</a></li>
          <li><a href="#projects">Projects</a></li>
          <li><a href="#signup">Newsletter</a></li>
        </ul>
      </div>
      <div class="nav-right">
        <div class="icons">
          <a href={profile.socials[0].url} aria-label="GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.3-3.4-1.3-.4-1.1-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.2-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.2-.4-1.2.1-2.6 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.6.6.7 1 1.6 1 2.7 0 3.9-2.4 4.8-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10 10 0 0 0 12 2z" />
            </svg>
          </a>
          <a href={profile.socials[1].url} aria-label="X">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 4l16 16M20 4L4 20" />
            </svg>
          </a>
          <a href={profile.socials[2].url} aria-label="RSS">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" />
              <circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none" />
            </svg>
          </a>
        </div>
        <span class="vdiv" aria-hidden="true"></span>
        <a class="pill pill-ember pill-sm" href={`mailto:${profile.email}`}>Get In Touch</a>
      </div>
    </nav>

    <section class="hero" id="top">
      <div class="notch notch-tl">
        <h1 class="display">Building<br />In Public</h1>
        <div class="hero-copy">
          <p>{profile.bio}</p>
          <div class="actions">
            <a class="pill pill-ember" href="#projects">Explore Projects</a>
            <a class="pill pill-dotted" href="#writing">Read The Log</a>
          </div>
        </div>
      </div>
      <canvas aria-hidden="true"></canvas>
      <div class="hero-strip">
        <div class="strip-label">
          <span class="tag">Projects</span>
          <span class="display count">{String(projects.length).padStart(2, '0')}</span>
        </div>
        {
          projects.map((p) => (
            <a class={`hcard${p.featured ? ' featured' : ''}`} href={p.url ?? '#projects'}>
              <div class="row">
                <span class="tag">{p.status}</span>
                <span class="year">{p.year}</span>
              </div>
              <h3 class="display">{p.name}</h3>
              <p>{p.blurb}</p>
            </a>
          ))
        }
      </div>
    </section>
  </header>

  <section class="wrap" id="writing">
    <div class="section-head">
      <h2 class="display">Writing</h2>
      <span class="tag">{posts.length} posts</span>
    </div>
    <div class="list-card">
      {
        posts.map((post) => (
          <a class="post" href="#writing">
            <span><span class="tag">{post.data.tags[0] ?? 'note'}</span></span>
            <div>
              <h3 class="display">{post.data.title}</h3>
              <p class="excerpt">{post.data.excerpt}</p>
            </div>
            <span class="date">{formatDate(post.data.date)}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="wrap" id="projects">
    <div class="section-head">
      <h2 class="display">All Projects</h2>
      <a href={profile.socials[0].url}>See Everything On GitHub</a>
    </div>
    <div class="proj-grid">
      {
        projects.map((p) => (
          <a class={`proj${p.featured ? ' featured' : ''}`} href={p.url ?? '#projects'}>
            <div class="row">
              <span class="tag">{p.status}</span>
              <span class="year">{p.year}</span>
            </div>
            <h3 class="display">{p.name}</h3>
            <p>{p.blurb}</p>
            <span class="more">{p.url ? 'Learn More →' : 'In The Workshop'}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="wrap">
    <div class="section-head">
      <h2 class="display">The Running Inventory</h2>
      <a href="#projects">Back To The Projects</a>
    </div>
    <div class="stats">
      {
        stats.map((s) => (
          <div class="stat">
            <p class="lbl">{s.lbl}</p>
            <p class="val display">{s.val}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap" id="signup">
    <div class="signup">
      <div>
        <h2 class="display">Get The Log In Your Inbox</h2>
        <p>One email when something ships or a new post lands. No noise.</p>
      </div>
      <form onsubmit="return false">
        <input type="email" placeholder="Email address" aria-label="Email address" />
        <button class="pill pill-ember" type="submit">Sign Up</button>
      </form>
    </div>
  </section>

  <footer class="wrap">
    <span>{profile.name} {year} © All rights reserved.</span>
    <div class="links">
      {profile.socials.map((s) => <a href={s.url}>{s.label}</a>)}
      <a href="/">All drafts</a>
    </div>
  </footer>
</Layout>

<script>
  // Halftone: orange dots on violet whose radius follows a smooth field of
  // blobs — where the field saturates the dots merge into solid ember, which
  // is what gives caldera.xyz's hero its violet→orange halftone look.
  const hero = document.querySelector<HTMLElement>('.caldera .hero');
  const canvas = hero?.querySelector('canvas');
  const ctx = canvas?.getContext('2d');

  if (hero && canvas && ctx) {
    // Anchor blobs: [x, y, strength, sigma] — x/y as fractions, sigma in width
    // units. Orange pools bottom-left and top-right, a violet valley mid-page.
    const blobs: [number, number, number, number][] = [
      [0.08, 0.9, 0.55, 0.2],
      [0.92, 0.08, 0.5, 0.2],
      [0.5, 0.5, -0.3, 0.2],
    ];
    const hash = (x: number, y: number) => {
      const n = Math.sin(x * 12.9898 + y * 78.233) * 43758.5453;
      return n - Math.floor(n);
    };
    // Smooth field in roughly [0, 1]: layered sines give the flowing
    // violet↔orange gradient, blobs anchor the composition.
    const field = (px: number, py: number, aspect: number) => {
      let v =
        0.42 +
        0.3 * Math.sin(px * 4.6 + py * 2.1 + 0.4) +
        0.22 * Math.sin(px * 1.9 - py * 5.3 + 2.0) +
        0.14 * Math.sin(px * 8.3 + py * 7.1);
      for (const [bx, by, s, sg] of blobs) {
        const dx = px - bx;
        const dy = (py - by) * aspect;
        v += s * Math.exp(-(dx * dx + dy * dy) / (2 * sg * sg));
      }
      return v;
    };

    const draw = () => {
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      if (!w || !h) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      ctx.fillStyle = '#524ae9';
      ctx.fillRect(0, 0, w, h);
      ctx.fillStyle = '#fc5000';

      const cell = w < 700 ? 11 : 14;
      const cols = Math.ceil(w / cell);
      const rows = Math.ceil(h / cell);
      const aspect = h / w;
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const px = (c + 0.5) / cols;
          const py = (r + 0.5) / rows;
          let v = field(px, py, aspect) + (hash(c, r) - 0.5) * 0.08;
          v = Math.min(1, Math.max(0, v));
          const rad = v * cell * 0.78;
          if (rad < 0.7) continue;
          ctx.beginPath();
          ctx.arc(c * cell + cell / 2, r * cell + cell / 2, rad, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    };

    draw();
    let to = 0;
    window.addEventListener('resize', () => {
      clearTimeout(to);
      to = window.setTimeout(draw, 150);
    });
  }
</script>
