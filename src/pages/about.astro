---
// Who is writing: the basics as one fact per line, in the first person.
import Topic from '../layouts/Topic.astro';
import { intro, basics } from '../data/about';
import { refs } from '../lib/refs';
---

<Topic href="/about" description="Who is writing: the basics.">
  <section class="part" id="basics" aria-labelledby="basics-head">
    <h2 class="part__head" id="basics-head">The basics</h2>
    <p class="part__note">{intro}</p>
    <ul class="facts">
      {basics.map((line) => <li set:html={refs(line)} />)}
    </ul>
  </section>
</Topic>
