---
import Topic from '../layouts/Topic.astro';
import { getProjects } from '../lib/content';

const projects = getProjects();
---

<Topic href="/work">
  <ul class="rows">
    {
      projects.map((p) => (
        <li>
          <a class="row" href={p.url}>
            <span class="row__top">
              <span class="row__title">{p.name}</span>
              <span class={`pill ${p.status === 'Building' ? 'pill--live' : ''}`}>{p.status}</span>
              <span class="row__meta">{p.year}</span>
            </span>
            <p class="row__blurb">{p.blurb}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Topic>
