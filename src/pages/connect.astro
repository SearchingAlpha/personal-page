---
import Topic from '../layouts/Topic.astro';
import { profile } from '../data/profile';
import { todoClass } from '../lib/todo';

const description = `Direct contact information, downloadable vCard, social channels, and exchange details for ${profile.name}.`;
---

<Topic href="/connect" description={description}>
  <!-- Section 1: Contact card and vCard -->
  <section class="part" id="card" aria-labelledby="card-head">
    <h2 class="part__head" id="card-head">My card</h2>
    <div class="plate">
      <p class="connect-lead">
        {profile.role}. You can download my complete contact card directly into your phone's address book, or reach out through any of the channels below.
      </p>

      <div class="connect-actions">
        <a href="/pablo-moral.vcf" download="pablo-moral.vcf" class="connect-vcf-btn">
          <span>Save contact to address book</span>
          <span class="connect-vcf-badge">.vcf ↓</span>
        </a>
      </div>

      <ul class="connect-links">
        {
          profile.socials.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer">
                <span class="links__label ref">{s.label}</span>
                <span class="links__handle">{s.handle} ↗</span>
              </a>
            </li>
          ))
        }
        <li>
          <a href={`mailto:${profile.email}`} class={todoClass(profile.email)}>
            <span class="links__label ref">Email</span>
            <span class="links__handle">{profile.email} ↗</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- Section 2: Exchange details -->
  <section class="part" id="exchange" aria-labelledby="exchange-head">
    <h2 class="part__head" id="exchange-head">Exchange details</h2>
    <div class="plate">
      <p class="connect-lead" style="margin-bottom: 20px;">
        If we just met or you want to say hello, leave your details below and I will follow up with you.
      </p>

      <form id="connect-form" class="connect-form" action="https://formsubmit.co/ajax/morvegpablo@gmail.com" method="POST">
        <input type="hidden" name="_subject" value="New contact from pablomoral.com/connect">
        <input type="hidden" name="_template" value="table">
        <input type="text" name="_honey" style="display:none">

        <div class="form-row">
          <div class="form-field">
            <label for="c-name">Name <span class="req">*</span></label>
            <input type="text" id="c-name" name="name" required placeholder="Your name" autocomplete="name" />
          </div>
          <div class="form-field">
            <label for="c-contact">Contact <span class="req">*</span></label>
            <input type="text" id="c-contact" name="contact" required placeholder="LinkedIn, Email, or WhatsApp" autocomplete="email" />
          </div>
        </div>

        <div class="form-field">
          <label for="c-note">Note <span class="opt">(optional)</span></label>
          <textarea id="c-note" name="note" rows="2" placeholder="What we discussed or what you are building..."></textarea>
        </div>

        <div class="form-actions">
          <button type="submit" class="connect-submit" id="c-submit">
            <span>Send details</span>
            <span class="connect-submit-arr">→</span>
          </button>
        </div>
      </form>

      <div id="c-status" class="connect-status hidden" role="status"></div>
    </div>
  </section>
</Topic>

<style>
  .part + .part {
    margin-top: 56px;
  }

  .connect-lead {
    font-family: var(--serif);
    font-size: clamp(17px, 2.5vw, 19px);
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0 0 20px 0;
  }

  .connect-actions {
    margin-bottom: 24px;
  }

  .connect-vcf-btn {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px;
    background: var(--paper);
    border: 1px solid var(--hair);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
    font-size: 15px;
    font-weight: 500;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .connect-vcf-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .connect-vcf-badge {
    font-family: var(--sans);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--accent);
    font-weight: 600;
  }

  /* Contact Links */
  .connect-links {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hair);
  }

  .connect-links > li {
    border-bottom: 1px solid var(--hair);
  }

  .connect-links > li:last-child {
    border-bottom: none;
  }

  .connect-links a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 12px 0;
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .connect-links a:hover {
    color: var(--accent);
  }

  .links__label {
    font-family: var(--serif);
    font-size: 17px;
  }

  .links__handle {
    font-family: var(--sans);
    font-size: 13px;
    color: var(--muted);
    transition: color var(--dur) var(--ease);
  }

  .connect-links a:hover .links__handle {
    color: var(--accent);
  }

  /* Form */
  .connect-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  @media (max-width: 540px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  label {
    font-family: var(--sans);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--muted);
    text-transform: uppercase;
  }

  .req {
    color: var(--accent);
  }

  .opt {
    text-transform: none;
    font-size: 11px;
    opacity: 0.8;
  }

  input, textarea {
    font-family: var(--sans);
    font-size: 14px;
    padding: 10px 12px;
    background: var(--paper);
    border: 1px solid var(--hair);
    border-radius: var(--radius);
    color: var(--ink);
    outline: none;
    transition: border-color var(--dur) var(--ease);
  }

  input:focus, textarea:focus {
    border-color: var(--accent);
  }

  textarea {
    resize: vertical;
    min-height: 60px;
  }

  .form-actions {
    margin-top: 4px;
  }

  .connect-submit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: var(--ink);
    color: var(--paper);
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--dur) var(--ease);
  }

  .connect-submit:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  .connect-status {
    margin-top: 16px;
    padding: 12px 14px;
    border-radius: var(--radius);
    font-family: var(--sans);
    font-size: 13px;
    line-height: 1.4;
  }

  .connect-status.success {
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--accent);
  }

  .hidden {
    display: none;
  }
</style>

<script is:inline>
  const form = document.getElementById('connect-form');
  const statusBox = document.getElementById('c-status');
  const submitBtn = document.getElementById('c-submit');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const dataObj = Object.fromEntries(formData.entries());

      try {
        const local = JSON.parse(localStorage.getItem('pablo_contacts') || '[]');
        local.unshift({ ...dataObj, at: new Date().toISOString() });
        localStorage.setItem('pablo_contacts', JSON.stringify(local));
      } catch {}

      submitBtn.disabled = true;
      submitBtn.style.opacity = '0.6';

      try {
        await fetch(form.action, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(dataObj)
        });

        statusBox.className = 'connect-status success';
        statusBox.innerHTML = 'Thank you — details received. I will be in touch soon.';
        form.reset();
      } catch (err) {
        statusBox.className = 'connect-status success';
        statusBox.innerHTML = 'Thank you — details saved locally. I will be in touch soon.';
        form.reset();
      } finally {
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
      }
    });
  }
</script>
