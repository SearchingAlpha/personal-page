---
// A small Feynman diagram as inline SVG, drawn in the plate's wireframe
// register: hairline fermions with arrows, wavy photons, cobalt vertices.
// Geometry is computed here so the markup stays a handful of paths.
import type { FeynmanKind } from '../data/atom';

interface Props {
  kind: FeynmanKind;
}

type Pt = [number, number];

const { kind } = Astro.props;

const fmt = (n: number) => +n.toFixed(2);
const P = (p: Pt) => `${fmt(p[0])} ${fmt(p[1])}`;

const line = (a: Pt, b: Pt) => `M${P(a)} L${P(b)}`;

/** A photon: quadratic half-waves alternating either side of the chord. */
function wavy(a: Pt, b: Pt, halfWaves = 6, amp = 4): string {
  const dx = b[0] - a[0];
  const dy = b[1] - a[1];
  const len = Math.hypot(dx, dy);
  const nx = -dy / len;
  const ny = dx / len;
  let d = `M${P(a)}`;
  for (let i = 0; i < halfWaves; i++) {
    const t1 = (i + 0.5) / halfWaves;
    const t2 = (i + 1) / halfWaves;
    const s = i % 2 ? -1 : 1;
    const c: Pt = [a[0] + dx * t1 + nx * amp * s, a[1] + dy * t1 + ny * amp * s];
    d += ` Q${P(c)} ${P([a[0] + dx * t2, a[1] + dy * t2])}`;
  }
  return d;
}

/** A small triangle at `p`, pointing along `dir`. */
function arrowAt(p: Pt, dir: Pt, size = 3.4): string {
  const len = Math.hypot(dir[0], dir[1]);
  const ux = dir[0] / len;
  const uy = dir[1] / len;
  const nx = -uy;
  const ny = ux;
  const tip: Pt = [p[0] + ux * size, p[1] + uy * size];
  const l: Pt = [p[0] - ux * size + nx * size * 0.8, p[1] - uy * size + ny * size * 0.8];
  const r: Pt = [p[0] - ux * size - nx * size * 0.8, p[1] - uy * size - ny * size * 0.8];
  return [tip, l, r].map(P).join(' ');
}

/** Arrow on the segment a→b at parameter t. Antiparticles run backwards. */
function arrowOn(a: Pt, b: Pt, t = 0.5, reverse = false): string {
  const p: Pt = [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
  const dir: Pt = reverse ? [a[0] - b[0], a[1] - b[1]] : [b[0] - a[0], b[1] - a[1]];
  return arrowAt(p, dir);
}

interface Diagram {
  fermions: [Pt, Pt][];
  photons: [Pt, Pt][];
  circles: { c: Pt; r: number }[];
  arrows: string[];
  vertices: Pt[];
}

// Canvas is 160 × 90.
const V1: Pt = [55, 45];
const V2: Pt = [105, 45];

const diagrams: Record<FeynmanKind, Diagram> = {
  // e⁻e⁺ annihilate to a photon, which pair-produces μ⁻μ⁺.
  annihilation: {
    fermions: [
      [[10, 10], V1],
      [[10, 80], V1],
      [V2, [150, 10]],
      [V2, [150, 80]],
    ],
    photons: [[V1, V2]],
    circles: [],
    arrows: [
      arrowOn([10, 10], V1, 0.5), // e⁻ in
      arrowOn([10, 80], V1, 0.5, true), // e⁺ in, arrow reversed
      arrowOn(V2, [150, 10], 0.5), // μ⁻ out
      arrowOn(V2, [150, 80], 0.5, true), // μ⁺ out, arrow reversed
    ],
    vertices: [V1, V2],
  },
  // A photon briefly becomes a fermion loop: vacuum polarisation.
  loop: {
    fermions: [],
    photons: [
      [[10, 45], [50, 45]],
      [[110, 45], [150, 45]],
    ],
    circles: [{ c: [80, 45], r: 30 }],
    arrows: [arrowAt([80, 15], [1, 0]), arrowAt([80, 75], [-1, 0])],
    vertices: [
      [50, 45],
      [110, 45],
    ],
  },
  // An electron emits a photon and carries on.
  emission: {
    fermions: [
      [[10, 70], [60, 70]],
      [[60, 70], [150, 70]],
    ],
    photons: [[[60, 70], [122, 14]]],
    circles: [],
    arrows: [arrowOn([10, 70], [60, 70], 0.5), arrowOn([60, 70], [150, 70], 0.55)],
    vertices: [[60, 70]],
  },
};

const d = diagrams[kind];
---

<svg class="feynman" viewBox="0 0 160 90" aria-hidden="true" focusable="false">
  <g class="feynman__lines">
    {d.fermions.map(([a, b]) => <path d={line(a, b)} />)}
    {d.photons.map(([a, b]) => <path d={wavy(a, b)} />)}
    {d.circles.map(({ c, r }) => <circle cx={c[0]} cy={c[1]} r={r} />)}
  </g>
  <g class="feynman__arrows">
    {d.arrows.map((points) => <polygon points={points} />)}
  </g>
  <g class="feynman__vertices">
    {d.vertices.map(([x, y]) => <circle cx={x} cy={y} r="2.2" />)}
  </g>
</svg>
